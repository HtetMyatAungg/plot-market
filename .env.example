# Copy to .env (never commit .env)
# Guide: "algorithm" (default, rule-based, no key needed) or "llm" (OpenAI tool-calling agent, needs OPENAI_API_KEY)
# GUIDE_MODE=llm
OPENAI_API_KEY=sk-your-openai-key-here
# Google Maps JavaScript API browser key (enable "Maps JavaScript API", restrict by HTTP referrer)
GOOGLE_MAPS_API_KEY=your-google-maps-browser-key
# Optional overrides
# GUIDE_MODEL=gpt-4o-mini
# Any OpenAI-compatible endpoint works, e.g. xAI: LLM_BASE_URL=https://api.x.ai/v1 + GUIDE_MODEL=grok-4 (key still goes in OPENAI_API_KEY)
# LLM_BASE_URL=https://api.openai.com/v1
# PORT=8765
# Where nominations.json / catalogues.json are written (default: ./data). On Railway, mount a Volume and set DATA_DIR=/data
# DATA_DIR=/data
# Optional demo admin token; enter the same value on /admin.html when enabled.
# ADMIN_TOKEN=
# Comma-separated demo domains whose storefront claims are automatically verified.
# DEMO_VERIFIED_DOMAINS=example.com
